@charset "utf-8";

#shopify-section-template--26373206540609__1663225962c56380eb .client-logo-item { text-align: center; background: rgb(237, 236, 236); border-radius: 20px; padding: 20px; }

#shopify-section-template--26373206540609__1663225962c56380eb .client-logo-item img { max-width: 100%; height: 112px; width: auto; margin: 0px auto; transition: 0.3s; }

@media (max-width: 768px) {

  #shopify-section-template--26373206540609__1663225962c56380eb .client-logo-item { margin: 10px; display: flex; justify-content: center; align-items: center; }
  #shopify-section-template--26373206540609__1663225962c56380eb .client-logo-item img { max-width: 100%; height: 100px; }
  #shopify-section-template--26373206540609__1663225962c56380eb .slick-slider .slick-prev { left: 0px; }

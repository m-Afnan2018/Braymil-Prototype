@charset "utf-8";

.gallery-section { margin: 40px 0px; }

.custom-gallery-two { background-image: url("https://cdn.shopify.com/s/files/1/0925/6638/9057/files/Section.webp?v=1774432716"); background-size: cover; background-position: center center; background-repeat: no-repeat; padding: 40px 0px; color: rgb(255, 255, 255); margin: 40px 0px; }

.gallery-grid { display: flex; align-items: center; justify-content: space-between; gap: 50px; }

.gallery-content p { max-width: 500px; line-height: 1.7; font-size: 16px; }

.gallery-btn { display: inline-block; margin-top: 15px; background: rgb(255, 255, 255); color: rgb(0, 0, 0); padding: 6px 18px; border-radius: 20px; text-decoration: none; font-size: 14px; }

.gallery-slider { position: relative; }

.image-stack { position: relative; width: 260px; height: 300px; }

.image-card { position: absolute; width: 260px; background: rgb(255, 255, 255); padding: 10px 10px 45px; border-radius: 6px; box-shadow: rgba(0, 0, 0, 0.2) 0px 10px 25px; transition: 0.5s; transform-origin: center bottom; }

.image-card img { width: 100%; height: 180px; object-fit: cover; border-radius: 4px; }

.slider-btn { position: absolute; top: 50%; transform: translateY(-50%); background: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; width: 35px; height: 35px; border-radius: 50%; cursor: pointer; font-size: 18px; }

.slider-btn.left { left: -50px; color: black; }

.slider-btn.right { right: -50px; color: black; }

@media (max-width: 768px) {
  .gallery-grid { flex-direction: column; text-align: center; }
  .slider-btn.left { left: 10px; }
  .slider-btn.right { right: 10px; }
}

.slider-btn { z-index: 10; }